# Welpack Engineering - Backend Configuration
# Copy this file to server/.env and fill in values.

NODE_ENV=development
PORT=5000

# Demo mode shows the 1-click sign-in buttons and the admin 'Reset Demo' button (which wipes ALL data).
# Leave it true on a private demo machine; set it to false before sharing the site or going live.
# If unset: on in development, off when NODE_ENV=production.
DEMO_MODE=true

# Only when running behind a reverse proxy / load balancer: how many proxies to trust (e.g. 1),
# so sign-in limits use the visitor's real address.
# TRUST_PROXY=1

# Frontend origin(s) allowed by CORS (comma-separated). Leave blank in dev to allow all.
CLIENT_ORIGIN=

# ==========================================
# DATABASE  (required)
# ==========================================
# Use a database dedicated to THIS project — don't point it at another
# project's MongoDB/container, even "just for now". If you have other Mongo
# projects running in Docker, give this one its own container + port so it
# never depends on (or gets wiped by) another project's lifecycle:
#   docker run -d --name welpack-fieldeng-mongo -p 27018:27017 \
#     -v welpack_fieldeng_data:/data/db --restart unless-stopped mongo:7
#
#  - Dedicated Docker container: mongodb://localhost:27018/welpack_fieldeng
#  - Local mongod:               mongodb://localhost:27017/welpack_fieldeng
#  - Atlas:                      mongodb+srv://user:pass@cluster.mongodb.net/welpack_fieldeng
MONGODB_URI=mongodb://localhost:27018/welpack_fieldeng
# Allow a throwaway in-memory database when MONGODB_URI is unreachable (data is NOT saved).
USE_MEMORY_DB=false

# ==========================================
# AUTH  (required)
# ==========================================
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# ==========================================
# TWILIO - real SMS OTP (optional; leave blank to disable)
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==========================================
# NODEMAILER - real email OTP (optional; leave blank to disable)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Welpack Engineering Support <support@welpack.com>"
