# Welpack Engineering - Backend Configuration
# Copy this file to server/.env and fill in values.

NODE_ENV=development
PORT=5000

# Frontend origin(s) allowed by CORS (comma-separated). Leave blank in dev to allow all.
CLIENT_ORIGIN=

# ==========================================
# DATABASE  (required)
# ==========================================
# A real, persistent MongoDB connection string.
#  - Local mongod:            mongodb://localhost:27017/apex_fieldeng
#  - Docker "mongo" replica:  mongodb://localhost:27017/apex_fieldeng?directConnection=true
#  - Atlas:                   mongodb+srv://user:pass@cluster.mongodb.net/apex_fieldeng
MONGODB_URI=mongodb://localhost:27017/apex_fieldeng
# Allow a throwaway in-memory database when MONGODB_URI is unreachable (data is NOT saved).
USE_MEMORY_DB=false

# ==========================================
# AUTH  (required)
# ==========================================
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# ==========================================
# TWILIO - real SMS OTP (optional; leave blank to disable)
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==========================================
# NODEMAILER - real email OTP (optional; leave blank to disable)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Welpack Engineering Support <support@welpack.com>"
