# Welpack Engineering - Backend Configuration
# Copy this file to server/.env and fill in values as needed.
# Everything except PORT is optional — leave blank for local testing
# (OTP codes are returned directly in the API response when unset).

PORT=5000

# -------------------------------------------------------------------
# Twilio - real SMS OTP delivery (https://console.twilio.com)
# -------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -------------------------------------------------------------------
# Nodemailer - real email OTP delivery (Gmail App Password, SendGrid, SMTP, ...)
# -------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Welpack Engineering Support <support@welpack.com>"
